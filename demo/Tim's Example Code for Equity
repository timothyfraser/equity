
install.packages("censusapi")
install.packages("tidycensus")
library(dplyr)
library(tidycensus)

readRenviron(".env")

Sys.getenv("CENSUS_API_KEY")

?censusapi::getCensus

get_census = function(vars = "B01003_001E", year = 2022, state = "36"){
censusapi::getCensus(
  name = "acs/acs5", vintage = year, vars = "B01003_001E",
  key = Sys.getenv("CENSUS_API_KEY"), 
  region = "tract:*", 
  regionin = paste0("state:", state)
  )
}

data = get_census(vars = c("B01003_001E"), year = 2022, state = "36")

saveRDS(data, file = "demo/mydata.rds")

readRDS("demo/mydata.rds")
